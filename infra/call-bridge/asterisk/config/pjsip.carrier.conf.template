; Rendered by /opt/nova/entrypoint.sh. Never commit real credentials.

[nova-carrier-auth]
type=auth
auth_type=userpass
username=${NOVA_SIP_TRUNK_USER}
password=${NOVA_SIP_TRUNK_PASSWORD}

[nova-carrier-aor]
type=aor
contact=sip:${NOVA_SIP_TRUNK_HOST}
qualify_frequency=30

[nova-carrier]
type=endpoint
transport=transport-udp
context=from-nova-carrier
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user=${NOVA_SIP_TRUNK_USER}
from_domain=${NOVA_SIP_TRUNK_FROM_DOMAIN}
outbound_auth=nova-carrier-auth
aors=nova-carrier-aor

[nova-carrier-identify]
type=identify
endpoint=nova-carrier
match=${NOVA_SIP_TRUNK_HOST}

[nova-carrier-registration]
type=registration
transport=transport-udp
outbound_auth=nova-carrier-auth
server_uri=sip:${NOVA_SIP_TRUNK_HOST}
client_uri=sip:${NOVA_SIP_TRUNK_USER}@${NOVA_SIP_TRUNK_FROM_DOMAIN}
contact_user=${NOVA_SIP_TRUNK_USER}
retry_interval=30
forbidden_retry_interval=300
expiration=300
line=yes
endpoint=nova-carrier
