# AI provider used by the media gateway: mock, gemini, openai, qwen, generic
NOVA_CALL_AI_PROVIDER=gemini
NOVA_CALL_AI_KEY=
NOVA_CALL_AI_MODEL=gemini-3.5-flash-lite
NOVA_CALL_AI_ENDPOINT=
NOVA_CALL_HANGUP_AFTER_REPLY=false

# Asterisk SIP/PSTN trunk. Use a DID or forward the user's mobile number to it.
NOVA_SIP_TRUNK_HOST=sip.example-provider.com
NOVA_SIP_TRUNK_USER=
NOVA_SIP_TRUNK_PASSWORD=
NOVA_SIP_TRUNK_FROM_DOMAIN=sip.example-provider.com

# Control-plane secrets. Generate long random values; never commit production values.
NOVA_CALL_CONTROL_TOKEN=replace-with-at-least-32-random-characters
NOVA_ASTERISK_AMI_USER=nova-control
NOVA_ASTERISK_AMI_SECRET=replace-with-at-least-32-random-characters

# Runtime tuning
NOVA_ENDPOINT_SILENCE_MS=850
NOVA_MIN_SPEECH_MS=450
NOVA_MAX_UTTERANCE_MS=18000
NOVA_MAX_CALL_TURNS=4
NOVA_SPEECH_RMS_THRESHOLD=180
NOVA_LOG_LEVEL=INFO
