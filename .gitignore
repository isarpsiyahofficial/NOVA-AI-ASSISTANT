# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated native voice runtime cache and large model assets.
# They are downloaded from official sherpa-onnx releases by
# tooling/prepare_native_voice_assets.sh and checksum-verified in CI.
/.cache/nova-native-voice/
/android/app/src/main/assets/sherpa_asr/*.onnx
/android/app/src/main/assets/sherpa_vad/
/android/app/src/main/assets/speaker_id/
/android/app/src/main/assets/sherpa_tts/
/android/app/src/main/assets/nova_voice_manifest/
